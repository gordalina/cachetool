{
    "name": "gordalina/cachetool",
    "description": "Manage your OPcache & APCu cache through the CLI",
    "keywords": [
        "cache",
        "opcache",
        "apcu",
        "fastcgi",
        "opcode",
        "fpm"
    ],
    "require": {
        "hollodotme/fast-cgi-client": "^4.0",
        "monolog/monolog": "^3.0",
        "php": ">=8.4.0",
        "psr/log": "^2.0 || ^3.0",
        "symfony/console": "^8.0",
        "symfony/dependency-injection": "^8.0",
        "symfony/finder": "^8.0",
        "symfony/process": "^8.0",
        "symfony/yaml": "^8.0",
        "symfony/http-client": "^8.0",
        "symfony/http-foundation": "^8.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.0"
    },
    "license": "MIT",
    "authors": [
        {
            "name": "gordalina",
            "email": "samuel.gordalina@gmail.com"
        }
    ],
    "autoload": {
        "psr-4": {
            "CacheTool\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "CacheTool\\": "tests/"
        }
    },
    "bin": [
        "bin/cachetool"
    ],
    "scripts": {
        "test": "phpunit"
    },
    "config": {
        "platform": {
            "php": "8.4.1"
        }
    }
}
